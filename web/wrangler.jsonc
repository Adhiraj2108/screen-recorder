{
  // Everything for the screen recorder's hosted videos lives in its own Worker and its own D1 database, named
  // with the "recorder-" prefix to keep it separate from anything else on the Cloudflare account.
  "name": "recorder-web",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  // No extra public preview addresses for this app.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recorder-db",
      "database_id": "ecccb548-9c78-4ce7-8d07-4a77249b95c5",
      "migrations_dir": "migrations"
    }
  ]
}
